{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-flash",
  "mcp": {
    "ziniao-contact": {
      "type": "local",
      "command": [
        "./scripts/start-ziniao-contact-mcp-macos.sh"
      ],
      "enabled": true,
      "timeout": 180000
    }
  },
  "instructions": [
    "prompts/ziniao-contact-rules.md"
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "logs/**",
      "temporary/**",
      ".venv/**"
    ]
  }
}
