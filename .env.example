# Django UI
DJANGO_SECRET_KEY=replace-with-a-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Browser Agent runtime (reserved for the implementation phase)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash
IMPORT_RULE_MODEL=deepseek/deepseek-v4-pro
DOM_FALLBACK_MODEL=deepseek/deepseek-v4-pro
DOM_FALLBACK_TIMEOUT_SECONDS=45
DOM_FALLBACK_MAX_CALLS_PER_STEP=2
DOM_FALLBACK_MAX_ELEMENTS=180
ZINIAO_ADAPTIVE_LOCATOR_PATH=temporary/ziniao-adaptive-locators.sqlite3
RUNTIME_LOG_ROOT=logs
RUNTIME_LOG_TIMEZONE=Asia/Shanghai
IMPORT_RULE_TIMEOUT_SECONDS=120
IMPORT_MAX_FILE_SIZE_MB=20
IMPORT_PREVIEW_ROWS=20
IMPORT_PREVIEW_SCAN_ROWS=200
IMPORT_PREVIEW_TTL_SECONDS=1800
IMPORT_PREVIEW_MAX_ENTRIES=20
IMPORT_TEMP_DIR=temporary/creator-imports
ZINIAO_API_BASE_URL=
ZINIAO_APP_ID=
ZINIAO_APP_SECRET=

# Ziniao local WebDriver (credentials stay in local .env only)
ZINIAO_COMPANY=
ZINIAO_USERNAME=
ZINIAO_PASSWORD=
ZINIAO_CONTACT_STORE_ID=
ZINIAO_CLIENT_PATH=/Applications/ziniao.app
ZINIAO_SOCKET_PORT=16851
ZINIAO_REQUEST_TIMEOUT_SECONDS=120
ZINIAO_CORE_TIMEOUT_SECONDS=600
ZINIAO_DRIVER_DIR=temporary/ziniao-webdrivers
ZINIAO_REUSE_BROWSER_SESSION=true
ZINIAO_BROWSER_SESSION_DIR=temporary/ziniao-browser-sessions
ZINIAO_BROWSER_PROBE_TIMEOUT_SECONDS=2
ZINIAO_BROWSER_LOCK_TIMEOUT_SECONDS=30
ZINIAO_BROWSER_HOME_TIMEOUT_SECONDS=60
ZINIAO_BROWSER_HOME_STABLE_SECONDS=2
# 0 表示登录/验证码页面可一直等待，正数表示最长等待秒数
ZINIAO_BROWSER_LOGIN_WAIT_SECONDS=0
ZINIAO_BROWSER_STATUS_PATH=temporary/ziniao-browser-status.json
ZINIAO_BROWSER_STATUS_PROBE_TIMEOUT_SECONDS=0.5
CREATOR_CONTACT_WORKER_HOST=127.0.0.1
CREATOR_CONTACT_WORKER_PORT=16852
CREATOR_CONTACT_WORKER_START_TIMEOUT_SECONDS=10
DATABASE_PATH=storage/agent.db
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
TASK_TIMEOUT_SECONDS=1800

# Gmail SMTP creator collaboration email
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
EMAIL_TIMEOUT_SECONDS=30
CREATOR_EMAIL_DAILY_LIMIT=100
CREATOR_EMAIL_SEND_INTERVAL_MIN_SECONDS=30
CREATOR_EMAIL_SEND_INTERVAL_MAX_SECONDS=60
CREATOR_EMAIL_MAX_ATTEMPTS_PER_DAY=3
CREATOR_EMAIL_IMAGE_PATH=web-ui/mailing/assets/FR7A6183.png
EMAIL_TEMPLATE_IMAGE_MAX_MB=5
EMAIL_TEMPLATE_TOTAL_IMAGE_MAX_MB=20
MAILING_MEDIA_ROOT=storage/mailing-media
SPORTS_JACKET_URL=
WOMENS_SHORTS_URL=
