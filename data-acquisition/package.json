{
  "name": "@e-commerce-agent/data-acquisition",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome CDP data acquisition MCP server",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspect:live": "tsx scripts/inspect-live.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "puppeteer-core": "25.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
